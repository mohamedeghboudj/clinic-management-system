# Placeholders only. Week 1 unit tests and the foundation demo need no .env.
# Pass an explicit environment mapping to the relevant settings loader.
ENVIRONMENT=development
LOG_LEVEL=INFO
CONNECT_TIMEOUT_SECONDS=5
DATABASE_URL=postgresql://USER:PASSWORD@REMOTE_HOST/DATABASE?sslmode=verify-full&sslrootcert=PATH_TO_CA_CERT  # pragma: allowlist secret
TOKEN_ISSUER=clinic-management-system
TOKEN_AUDIENCE=clinic-staff
SIGNING_KEY=REPLACE_VIA_BACKEND_SECRET_STORE

# Desktop settings: no database or signing credentials are delivered to clients.
API_BASE_URL=https://YOUR_BACKEND_HOST/api/v1
REQUEST_TIMEOUT_SECONDS=10
LOCALE=en
ALLOW_INSECURE_LOCALHOST=false
